<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/notification_card_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:background="@drawable/icon_tile_green"
            android:src="@drawable/ic_package"
            android:contentDescription="Parcel" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/parcel_app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MyApp · 12m"
                android:textColor="#52657A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/parcel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Your parcel is out for delivery"
                android:textColor="#12243A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:layout_width="24dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="⌃"
            android:textColor="#52657A"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/parcel_order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Order #PKG2048 · 2 items"
        android:textColor="#52657A"
        android:textSize="11sp" />

    <!-- Delivery progress track -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="#159B69" />

        <TextView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/dot_green" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="#159B69" />

        <TextView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/dot_green" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="#159B69" />

        <TextView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:background="@drawable/dot_green" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="#D2DFE8" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shipped"
                android:textColor="#24364A"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/parcel_shipped_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apr 26"
                android:textColor="#6A8298"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In transit"
                android:textColor="#24364A"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/parcel_transit_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apr 27"
                android:textColor="#6A8298"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Out for delivery"
                android:textColor="#24364A"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/parcel_eta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#159B69"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ETA panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/map_preview">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:background="@drawable/icon_tile_green"
            android:src="@drawable/ic_map_pin"
            android:contentDescription="Delivery location" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/parcel_arrival_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arriving today"
                android:textColor="#17304A"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/parcel_arrival_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="by 8:00 PM"
                android:textColor="#52657A"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/parcel_track"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:background="@drawable/action_button_light"
            android:text="›"
            android:textColor="#17304A"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/parcel_track_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/action_button_green"
            android:text="Track order"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/parcel_details_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/action_button_light"
            android:text="View details"
            android:textColor="#17304A"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>