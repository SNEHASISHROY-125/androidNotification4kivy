<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/notification_card_dark">

    <!-- App icon and title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/transfer_app_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:background="@drawable/icon_tile_blue"
            android:src="@drawable/ic_upload"
            android:contentDescription="Transfer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/transfer_app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MyApp · 2m"
                android:textColor="#B8CBE0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/transfer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Uploading backup.zip"
                android:textColor="#F4F8FF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/transfer_expand"
            android:layout_width="24dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="⌃"
            android:textColor="#DCEBFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Speed and transferred bytes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/transfer_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2.4 MB/s · 8.4 MB / 20 MB"
            android:textColor="#D2E0F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/transfer_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="42%"
            android:textColor="#DCEBFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/transfer_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="9dp"
        android:max="100"
        android:progress="42"
        android:indeterminate="false"
        android:progressDrawable="@drawable/progress_blue" />

    <!-- Activity icon and ETA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="@drawable/icon_tile_blue"
            android:src="@drawable/ic_upload"
            android:contentDescription="Upload activity" />

        <TextView
            android:id="@+id/transfer_eta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="ETA 00:00:06"
            android:textColor="#D2E0F0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action rows: attach PendingIntents from Python -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/transfer_pause"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/action_button_blue"
            android:text="Ⅱ  Pause"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/transfer_cancel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/action_button_outline"
            android:text="×  Cancel"
            android:textColor="#E7F1FF"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>